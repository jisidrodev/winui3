<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyNotesApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyNotesApp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:MyNotesApp.Model"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Margin="8" Symbol="Home" />
                <TextBlock
                    Margin="8"
                    Style="{StaticResource SubheaderTextBlockStyle}"
                    Text="Notes" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock
                    Margin="4"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Note type:" />
                <ComboBox
                    MinWidth="120"
                    Margin="0,2,6,4"
                    HorizontalAlignment="Right"
                    ItemsSource="{x:Bind ViewModel.NotesTypes}"
                    SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
        <ListView
            Grid.Row="1"
            DoubleTapped="{x:Bind ViewModel.ListViewDoubleTapped}"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectedItem="{x:Bind ViewModel.SelectedNoteItem, Mode=TwoWay}">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="0,0,0,1">
                            <TextBlock
                                Margin="4,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Type" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                Margin="5,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Title" />
                        </Border>
                        <Border
                            Grid.Column="2"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                Margin="5,0,0,0"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="Content" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Note">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Path=EnumNoteType}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Path=Title}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Path=Content}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border
            Grid.Row="2"
            Margin="4,0"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="8,8,0,8"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.AddOrEditCommand}"
                    Content="Add/Edit Item" />
                <Button
                    Margin="8"
                    Command="{x:Bind ViewModel.DeleteCommand}"
                    Content="Delete Item" />
                <Button
                    Margin="8,8,0,8"
                    Command="{x:Bind ViewModel.SendToastCommand}"
                    Content="Send notification" />
                <Button
                    Margin="8,8,0,8"
                    Command="{x:Bind ViewModel.SendToastWithTextCommand}"
                    Content="Send notification with text" />
            </StackPanel>
        </Border>
        <InfoBar x:Name="notifyInfoBar" Grid.Row="3" />

    </Grid>
</Page>
