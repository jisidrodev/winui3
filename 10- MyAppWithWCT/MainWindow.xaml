<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MyAppWithWCT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyAppWithWCT"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:wctui="using:CommunityToolkit.WinUI.UI.Controls"
    Title="MyAppWithWCT"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <wctcontrols:HeaderedContentControl
            x:Name="headerPanel"
            Margin="8"
            Header="Product Inventory">
            <wctui:DataGrid
                Margin="8"
                AlternatingRowBackground="{ThemeResource SystemControlBackgroundListLowBrush}"
                AutoGenerateColumns="True"
                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                ItemsSource="{x:Bind Products}" />
        </wctcontrols:HeaderedContentControl>
    </Grid>
</Window>
